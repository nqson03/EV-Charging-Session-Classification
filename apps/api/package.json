{
  "name": "@evsa/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply evsa --local",
    "db:migrate:remote": "wrangler d1 migrations apply evsa --remote",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vitest run --dir test"
  },
  "dependencies": {
    "@evsa/core": "workspace:*",
    "hono": "^4.13.9",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.2",
    "@types/node": "^26.6.2",
    "read-excel-file": "^9.3.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.140.0"
  }
}