{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ev-session-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  // Keep preview URLs off so they never sit outside an Access application if sign-in is enabled later.
  "preview_urls": false,

  // The React build is served by this same Worker, so UI and API share one origin
  // and one Cloudflare Access application. Static asset requests are free.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evsa",
      // Replace with the id printed by: npx wrangler d1 create evsa
      "database_id": "6d07cf47-772b-49ad-8056-10bdcf0fceec",
      "migrations_dir": "migrations"
    }
  ],

  // Optional response cache (recommended). Create with: npx wrangler kv namespace create CACHE
  "kv_namespaces": [
    { "binding": "CACHE", "id": "d00433ac5f484509ba3d8a1e29d551b0" }
  ],

  "vars": {
    // Optional sign-in. Leave empty for an open app; fill both to require Cloudflare Access (see README).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
